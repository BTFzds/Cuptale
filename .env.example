# Local SQLite (default)
DATABASE_URL="file:./dev.db"

# Production (Vercel + Neon): switch prisma/schema.prisma provider to "postgresql", then:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

ADMIN_PASSWORD="offsip-home"
ADMIN_SESSION_SECRET="please-change-me-to-a-long-random-string"

DEEPSEEK_API_KEY="sk-xxxxxxxx"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-flash"

# Optional; without it, uploads go to /public/uploads (local only)
BLOB_READ_WRITE_TOKEN=""
