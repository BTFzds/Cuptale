# Postgres：Neon 或 Supabase 均可（杯叙用 Prisma）
# Supabase：Settings → Database → Connection string → URI（建表建议 5432 session）
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

ADMIN_PASSWORD="offsip-home"
ADMIN_SESSION_SECRET="please-change-me-to-a-long-random-string"

DEEPSEEK_API_KEY="sk-xxxxxxxx"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-flash"
# 可选：带图识别时用（若 flash 不支持视觉再换）
DEEPSEEK_MODEL_VISION="deepseek-flash"

# Netlify 图片上传必填（与红九月同套路：Supabase Storage）
# Project Settings → API：Project URL + service_role
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# 在 Storage 建公开桶名为 cuptale-images（也可由首次上传自动创建）

# 可选：Vercel Blob（有则优先于本地 uploads；Netlify 请用上面的 Supabase）
BLOB_READ_WRITE_TOKEN=""
