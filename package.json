{
  "name": "cuptale",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "vercel-build": "prisma generate && node scripts/dedupe-drinks.mjs && prisma db push --accept-data-loss && next build",
    "netlify-build": "prisma generate && node scripts/dedupe-drinks.mjs && prisma db push --accept-data-loss && next build",
    "preflight:netlify": "prisma generate && npx tsc --noEmit && next build",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/blob": "^0.27.3",
    "framer-motion": "^11.18.2",
    "jose": "^5.10.0",
    "next": "^14.2.25",
    "openai": "^4.89.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.13",
    "@types/node": "^20.17.24",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.25",
    "postcss": "^8.5.3",
    "prisma": "^6.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
